# Anthropic API anahtari - demo botun gercek cevap vermesi icin
# Anahtar yoksa bot yedek (scripted) modda calisir.
ANTHROPIC_API_KEY=

# Anahtar bir workspace'e bagli degilse (org seviyesi anahtar) workspace id de gerekir.
# Console > Settings > Workspaces adresinde gorunur, wrkspc_ ile baslar.
ANTHROPIC_WORKSPACE_ID=
